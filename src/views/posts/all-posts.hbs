{{setTitle 'Catalog Page'}}

<section id="catalog">
    <h1>All posts</h1>
    <div class="wrap">
        {{#each posts}}
        <!-- If there are posts for car in the database display each of them -->
        <div class="car-card car-card-info">
            <div class="front">
                <img src="{{image}}" alt="{{model}}">
            </div>
            <div class="back">
                <h1>{{model}}</h1>
                <h2>Top Speed: {{topSpeed}} kmph</h2>
                <p>{{description}}</p>
                <a href="/posts/{{id}}/details" class="details">Details</a>
            </div>
        </div>
        {{else}}
        <!-- If there are still no posts in the database display: -->
        <div class="no-posts">
            <p class="no-cars">There are no car posts yet...</p>
        </div>
        {{/each}}
    </div>
</section>